{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Work-in",
  "version": "1.0.0",
  "identifier": "id.reinalda123.workin",
  "build": {
    "frontendDist": "../app-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Work-in",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#E9E9EA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
